# Copy to .env and fill in what you want. Everything is optional.

# Paid detection APIs (each runs only when its key is set; files are uploaded to that company)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
HIVE_API_KEY=
GPTZERO_API_KEY=

# Local models (need requirements-ml.txt). Set SCANNER_ML=0 to turn them off.
# SCANNER_ML=1
# Binoculars uses two 7B models by default (needs a big GPU, or lots of RAM and patience).
# A smaller pair, e.g. Qwen/Qwen2.5-1.5B and Qwen/Qwen2.5-1.5B-Instruct, works but needs its own threshold.
# SCANNER_BINOCULARS_OBSERVER=tiiuae/falcon-7b
# SCANNER_BINOCULARS_PERFORMER=tiiuae/falcon-7b-instruct
# SCANNER_BINOCULARS_THRESHOLD=0.9015
# SCANNER_TEXT_MODELS=Hello-SimpleAI/chatgpt-detector-roberta
# SCANNER_IMAGE_MODELS=Organika/sdxl-detector,umm-maybe/AI-image-detector
# SCANNER_AUDIO_MODELS=MelodyMachine/Deepfake-audio-detection-V2
